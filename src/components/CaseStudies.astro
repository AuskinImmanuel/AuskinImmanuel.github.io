---
import { site } from '../data/site';
import { parseMarks } from '../lib/markup';
---

<section id="work" class="work">
  <div class="container-wide">
    <h2 class="section-label reveal">Selected work</h2>
    <div class="bento">
      {
        site.caseStudies.map((c, i) => (
          <article
            class={`card study reveal ${c.hero ? 'study-hero' : ''} ${c.wide ? 'study-wide' : ''}`}
            style={`transition-delay: ${i * 70}ms`}
          >
            <div class="study-copy">
              <span class="badge">{c.badge}</span>
              <h3 class="study-title">{c.title}</h3>
              <p class="study-blurb">
                {parseMarks(c.blurb).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}
              </p>
              {c.art === 'graph' && (
                <svg class="study-art art-net" viewBox="0 0 240 96" fill="none" aria-hidden="true">
                  <g stroke="var(--border)" stroke-width="1">
                    <path d="M120 48 L52 22 M120 48 L38 56 M120 48 L64 84 M120 48 L104 14 M120 48 L150 16 M120 48 L196 30 M120 48 L206 62 M120 48 L162 86 M52 22 L104 14 M38 56 L64 84 M196 30 L150 16 M206 62 L162 86" />
                  </g>
                  <g fill="var(--bg-secondary)" stroke="var(--border)" stroke-width="1">
                    <circle cx="52" cy="22" r="5" />
                    <circle cx="38" cy="56" r="5" />
                    <circle cx="64" cy="84" r="5" />
                    <circle cx="104" cy="14" r="5" />
                    <circle cx="150" cy="16" r="5" />
                    <circle cx="196" cy="30" r="5" />
                    <circle cx="206" cy="62" r="5" />
                    <circle cx="162" cy="86" r="5" />
                  </g>
                  <circle class="art-core" cx="120" cy="48" r="9" fill="var(--accent)" />
                  <circle cx="150" cy="16" r="5" fill="var(--accent)" opacity="0.55" />
                  <circle cx="64" cy="84" r="5" fill="var(--accent)" opacity="0.35" />
                </svg>
              )}
              {c.art === 'gaps' && (
                <svg class="study-art art-flow" viewBox="0 0 240 96" fill="none" aria-hidden="true">
                  <g stroke="var(--border)" stroke-width="1">
                    <path d="M44 14 C 110 14, 130 48, 186 48" />
                    <path d="M44 31 C 105 31, 128 48, 186 48" />
                    <path d="M44 48 L 186 48" />
                    <path d="M44 65 C 105 65, 128 48, 186 48" />
                    <path d="M44 82 C 110 82, 130 48, 186 48" />
                  </g>
                  <g fill="var(--bg-secondary)" stroke="var(--border)" stroke-width="1">
                    <circle cx="44" cy="14" r="6" />
                    <circle cx="44" cy="31" r="6" />
                    <circle cx="44" cy="48" r="6" />
                    <circle cx="44" cy="65" r="6" />
                    <circle cx="44" cy="82" r="6" />
                  </g>
                  <circle class="art-core" cx="186" cy="48" r="11" fill="var(--accent)" />
                </svg>
              )}
            </div>
            {c.lines && (
              <div class="study-lines">
                <span class="study-lines-label">Agent lines on this payor</span>
                {c.lines.map((l) => (
                  <div class="study-line">
                    <span class="study-line-name">{l.name}</span>
                    <span class="study-line-note">{l.note}</span>
                  </div>
                ))}
              </div>
            )}
            <div class="study-stat">
              <span class="study-stat-value">{c.stat}</span>
              <span class="study-stat-label">{c.statLabel}</span>
            </div>
            {c.bar && (
              <div class="study-bar" aria-hidden="true">
                <div class="study-bar-row">
                  <span class="study-bar-tag">before</span>
                  <div class="study-bar-track">
                    <div class="study-bar-fill is-before" style={`width: ${c.bar.before}%`} />
                  </div>
                </div>
                <div class="study-bar-row">
                  <span class="study-bar-tag">after</span>
                  <div class="study-bar-track">
                    <div class="study-bar-fill is-after" style={`width: ${c.bar.after}%`} />
                  </div>
                </div>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .study {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    overflow: hidden;
  }
  .study-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .study-art {
    margin-top: 20px;
    width: 100%;
    max-width: 260px;
    height: auto;
  }
  /* the artwork draws itself in when the card reveals */
  .art-net path {
    stroke-dasharray: 1500;
    stroke-dashoffset: 1500;
    transition: stroke-dashoffset 1.6s var(--ease) 0.25s;
  }
  .art-flow path {
    stroke-dasharray: 230;
    stroke-dashoffset: 230;
    transition: stroke-dashoffset 1.2s var(--ease) 0.25s;
  }
  .study.visible .art-net path,
  .study.visible .art-flow path {
    stroke-dashoffset: 0;
  }
  .study-art circle {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s var(--ease), fill 0.35s var(--ease);
  }
  .study:hover .study-art circle {
    transform: scale(1.18);
  }
  .study:hover .art-core {
    fill: var(--green);
    transform: scale(1.3);
  }
  .study-lines {
    margin-top: 26px;
    width: 100%;
    max-width: 440px;
  }
  .study-hero .study-lines {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .study-hero .study-line {
    padding: 14px 2px;
  }
  .study-lines-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .study-line {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 11px 2px;
    border-bottom: 1px solid var(--border);
  }
  .study-line::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .study-line:hover::after {
    transform: scaleX(1);
  }
  .study-line-name {
    font-weight: 500;
    font-size: 0.92rem;
  }
  .study-line-note {
    color: var(--text-muted);
    font-size: 0.84rem;
    text-align: right;
  }
  .study-bar-fill {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s var(--ease) 0.35s;
  }
  .study.visible .study-bar-fill {
    transform: scaleX(1);
  }
  .study-wide {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .study-wide .study-blurb {
    max-width: 58ch;
  }
  .study-wide .study-stat {
    margin-top: 0;
    padding-top: 0;
    text-align: right;
    align-items: flex-end;
  }
  .study-hero {
    grid-column: span 2;
    grid-row: span 2;
    background:
      radial-gradient(circle at 85% 110%, var(--atmo-sky) 0%, transparent 55%),
      radial-gradient(circle at 10% -10%, var(--atmo-mint) 0%, transparent 45%),
      var(--bg);
  }
  .study-title {
    margin-top: 20px;
    font-size: 1.35rem;
  }
  .study-hero .study-title {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
  }
  .study-blurb {
    margin-top: 12px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .study-stat {
    margin-top: auto;
    padding-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .study-stat-value {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .study-hero .study-stat-value {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
  }
  .study-stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .study-bar {
    margin-top: 22px;
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .study-bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .study-bar-tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    width: 46px;
  }
  .study-bar-track {
    flex: 1;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--bg-secondary);
    overflow: hidden;
  }
  .study-bar-fill {
    height: 100%;
    border-radius: var(--radius-pill);
  }
  .study-bar-fill.is-before {
    background: var(--border);
  }
  .study-bar-fill.is-after {
    background: var(--accent);
  }
  @media (max-width: 900px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .study-hero {
      grid-column: span 2;
      grid-row: auto;
    }
  }
  @media (max-width: 620px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .study-hero {
      grid-column: auto;
    }
  }
</style>
