---
import { site } from '../data/site';
import { parseMarks } from '../lib/markup';
const os = site.openSource;
---

<section id="opensource" class="opensource">
  <div class="container">
    <h2 class="section-label reveal">Building in public</h2>
    <article class="card os-card reveal">
      <div class="os-copy">
        <h3 class="os-title">{os.title}</h3>
        <p class="os-blurb">{parseMarks(os.blurb).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
      </div>
      <a class="btn-ghost" href={os.link} target="_blank" rel="noopener">{os.linkLabel}</a>
    </article>
    {
      os.more.length > 0 && (
        <div class="os-more reveal">
          {os.more.map((r) => (
            <a class="os-repo" href={r.href} target="_blank" rel="noopener">
              <h4 class="os-repo-title">{r.title}</h4>
              <p class="os-repo-note">{r.note}</p>
            </a>
          ))}
        </div>
      )
    }
    {
      site.writing.length > 0 && (
        <ul class="os-writing">
          {site.writing.map((w) => (
            <li>
              <a href={w.href}>{w.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .os-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background:
      radial-gradient(circle at 105% -20%, var(--atmo-lavender) 0%, transparent 55%),
      var(--surface);
  }
  .os-title {
    font-size: 1.3rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .os-blurb {
    margin-top: 10px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 62ch;
  }
  .os-card .btn-ghost {
    flex-shrink: 0;
  }
  .os-more {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .os-repo {
    display: block;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 20px;
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .os-repo:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .os-repo-title {
    font-size: 0.95rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .os-repo-note {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .os-writing {
    margin-top: 24px;
    list-style: none;
  }
  .os-writing a {
    color: var(--accent);
  }
  @media (max-width: 700px) {
    .os-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .os-more {
      grid-template-columns: 1fr;
    }
  }
</style>
