---
import { site } from '../data/site';
const os = site.openSource;
---

<section id="opensource" class="opensource">
  <div class="container">
    <h2 class="section-label reveal">Building in public</h2>
    <article class="card os-card reveal">
      <div class="os-copy">
        <h3 class="os-title">{os.title}</h3>
        <p class="os-blurb">{os.blurb}</p>
      </div>
      <a class="btn-ghost" href={os.link} target="_blank" rel="noopener">{os.linkLabel}</a>
    </article>
    {
      site.writing.length > 0 && (
        <ul class="os-writing">
          {site.writing.map((w) => (
            <li>
              <a href={w.href}>{w.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .os-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background:
      radial-gradient(circle at 105% -20%, var(--atmo-lavender) 0%, transparent 55%),
      var(--surface);
  }
  .os-title {
    font-size: 1.3rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .os-blurb {
    margin-top: 10px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 62ch;
  }
  .os-card .btn-ghost {
    flex-shrink: 0;
  }
  .os-writing {
    margin-top: 24px;
    list-style: none;
  }
  .os-writing a {
    color: var(--accent);
  }
  @media (max-width: 700px) {
    .os-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
