---
import { site } from '../data/site';
const o = site.origin;
---

<section id="origin" class="origin band">
  <div class="container-wide origin-grid">
    <div class="origin-story">
      <h2 class="section-label reveal">{o.label}</h2>
      {o.narrative.map((para, i) => <p class="origin-para reveal" style={`transition-delay: ${i * 70}ms`}>{para}</p>)}
      <a class="origin-receipts reveal" href={o.receipts.href} target="_blank" rel="noopener" style="transition-delay: 220ms">
        {o.receipts.line} <span class="origin-receipts-link">{o.receipts.label} &rarr;</span>
      </a>
    </div>
    <div class="origin-groups">
      {
        o.groups.map((g, gi) => (
          <div class="origin-group reveal" style={`transition-delay: ${gi * 90}ms`}>
            <h3 class="origin-group-label">{g.label}</h3>
            <ul class="origin-list">
              {g.items.map((item) => (
                <li>
                  <span class="origin-item-title">{item.title}</span>
                  <span class="origin-item-detail">{item.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .origin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }
  .origin-para {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 52ch;
  }
  .origin-para + .origin-para {
    margin-top: 18px;
  }
  .origin-receipts {
    display: block;
    margin-top: 28px;
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 52ch;
    transition: color 0.2s var(--ease);
  }
  .origin-receipts:hover .origin-receipts-link {
    color: var(--accent-hover);
  }
  .origin-receipts-link {
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
  }
  .origin-groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 45px;
  }
  .origin-group-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .origin-list {
    list-style: none;
    margin-top: 6px;
  }
  .origin-list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .origin-item-title {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .origin-item-detail {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  @media (max-width: 900px) {
    .origin-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .origin-groups {
      padding-top: 0;
    }
  }
</style>
