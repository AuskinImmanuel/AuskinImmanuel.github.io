---
import { site } from '../data/site';
---

<section id="experience" class="experience">
  <div class="container">
    <p class="section-label reveal">Experience</p>
    <div class="exp-list">
      {
        site.experience.map((e, i) => (
          <article class="exp-item reveal" style={`transition-delay: ${i * 60}ms`}>
            <div class="exp-head">
              <h3 class="exp-role">{e.role}</h3>
              <span class="exp-time">{e.time}</span>
            </div>
            <p class="exp-company">{e.company}</p>
            <p class="exp-blurb">{e.blurb}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .exp-item {
    padding: 30px 0;
    border-top: 1px solid var(--border);
  }
  .exp-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
  }
  .exp-role {
    font-size: 1.2rem;
  }
  .exp-time {
    font-size: 0.88rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .exp-company {
    margin-top: 4px;
    color: var(--accent);
    font-size: 0.95rem;
  }
  .exp-blurb {
    margin-top: 14px;
    color: var(--text-muted);
    max-width: 680px;
    line-height: 1.6;
  }
</style>
