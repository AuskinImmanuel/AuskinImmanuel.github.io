---
import { site } from '../data/site';
---

<section id="skills" class="skills">
  <div class="container">
    <p class="section-label reveal">Skills</p>
    <div class="skills-grid">
      {
        site.skills.map((g, i) => (
          <div class="skill-group reveal" style={`transition-delay: ${i * 60}ms`}>
            <h3 class="skill-group-title">{g.group}</h3>
            <ul class="skill-items">
              {g.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="education reveal">
      {site.education.degree}. {site.education.school}. {site.education.time}.
    </p>
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px 32px;
  }
  .skill-group-title {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .skill-items {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .skill-items li {
    font-size: 0.88rem;
    padding: 7px 13px;
    background: var(--bg-secondary);
    border-radius: 980px;
  }
  .education {
    margin-top: 52px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  @media (max-width: 700px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
