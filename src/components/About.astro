---
import { site } from '../data/site';
---

<section id="about" class="about">
  <div class="container">
    <p class="section-label reveal">About</p>
    {site.about.map((para) => <p class="about-para reveal">{para}</p>)}
  </div>
</section>

<style>
  .about-para {
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    max-width: 760px;
  }
  .about-para + .about-para {
    margin-top: 28px;
  }
</style>
