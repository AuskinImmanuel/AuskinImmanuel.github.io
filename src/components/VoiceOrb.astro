---
// The hero orb. A soft CSS gradient sphere is the universal base layer
// (no JS, no WebGL2, reduced motion); on top, the orb shader from
// ElevenLabs UI (github.com/elevenlabs/ui, MIT) rendered with raw WebGL2,
// no framework. The orb "hears" the page: scroll and pointer energy
// stand in for microphone volume.
---

<div class="orb" id="orb-visual">
  <div class="orb-base" aria-hidden="true"></div>
  <div class="orb-ring" aria-hidden="true"></div>
  <canvas class="orb-canvas" id="voice-orb" aria-hidden="true"></canvas>
</div>

<style>
  .orb {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    max-width: 440px;
    margin: 0 auto;
  }
  .orb-base {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, color-mix(in srgb, #a7e5d3 72%, transparent) 0%, transparent 55%),
      radial-gradient(circle at 68% 38%, color-mix(in srgb, #c8b8e0 62%, transparent) 0%, transparent 58%),
      radial-gradient(circle at 50% 74%, color-mix(in srgb, #a8c8e8 66%, transparent) 0%, transparent 60%),
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent) 14%, transparent) 0%, transparent 72%);
    filter: blur(18px);
    opacity: 0.9;
  }
  .orb-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }
  /* live-call status ring: green = listening, accent = speaking */
  .orb-ring {
    position: absolute;
    inset: 5%;
    border-radius: 50%;
    border: 2px solid transparent;
    pointer-events: none;
    opacity: 0;
    transition: border-color 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .orb.is-connecting .orb-ring {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    animation: orb-ring-pulse 1.2s ease-in-out infinite;
  }
  .orb.is-listening .orb-ring {
    opacity: 1;
    border-color: color-mix(in srgb, var(--green) 75%, transparent);
    animation: orb-ring-breathe 2.4s ease-in-out infinite;
  }
  .orb.is-speaking .orb-ring {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    animation: orb-ring-breathe 1.1s ease-in-out infinite;
  }
  @keyframes orb-ring-breathe {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.035);
    }
  }
  @keyframes orb-ring-pulse {
    0%, 100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script>
  const VERT = `#version 300 es
in vec2 position;
out vec2 vUv;
void main() {
  vUv = position * 0.5 + 0.5;
  gl_Position = vec4(position, 0.0, 1.0);
}`;

  // Fragment shader adapted from ElevenLabs UI's orb (MIT), ported to
  // GLSL ES 3.00, with an added edge feather and premultiplied output.
  const FRAG = `#version 300 es
precision highp float;
uniform float uTime;
uniform float uAnimation;
uniform float uInverted;
uniform float uOffsets[7];
uniform vec3 uColor1;
uniform vec3 uColor2;
uniform float uInputVolume;
uniform float uOutputVolume;
uniform float uOpacity;
uniform sampler2D uPerlinTexture;
in vec2 vUv;
out vec4 fragColor;

const float PI = 3.14159265358979323846;

bool drawOval(vec2 polarUv, vec2 polarCenter, float a, float b, bool reverseGradient, float softness, out vec4 color) {
    vec2 p = polarUv - polarCenter;
    float oval = (p.x * p.x) / (a * a) + (p.y * p.y) / (b * b);
    float edge = smoothstep(1.0, 1.0 - softness, oval);
    if (edge > 0.0) {
        float gradient = reverseGradient ? (1.0 - (p.x / a + 1.0) / 2.0) : ((p.x / a + 1.0) / 2.0);
        gradient = mix(0.5, gradient, 0.1);
        color = vec4(vec3(gradient), 0.85 * edge);
        return true;
    }
    return false;
}

vec3 colorRamp(float grayscale, vec3 color1, vec3 color2, vec3 color3, vec3 color4) {
    if (grayscale < 0.33) {
        return mix(color1, color2, grayscale * 3.0);
    } else if (grayscale < 0.66) {
        return mix(color2, color3, (grayscale - 0.33) * 3.0);
    } else {
        return mix(color3, color4, (grayscale - 0.66) * 3.0);
    }
}

vec2 hash2(vec2 p) {
    return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453);
}

float noise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float n = mix(
        mix(dot(hash2(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0)),
            dot(hash2(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0)), u.x),
        mix(dot(hash2(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0)),
            dot(hash2(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0)), u.x),
        u.y
    );
    return 0.5 + 0.5 * n;
}

float sharpRing(vec3 decomposed, float time) {
    float noise = mix(
        noise2D(vec2(decomposed.x, time) * 5.0),
        noise2D(vec2(decomposed.y, time) * 5.0),
        decomposed.z
    );
    noise = (noise - 0.5) * 2.5;
    return 1.0 + noise * 0.45;
}

float smoothRing(vec3 decomposed, float time) {
    float noise = mix(
        noise2D(vec2(decomposed.x, time) * 6.0),
        noise2D(vec2(decomposed.y, time) * 6.0),
        decomposed.z
    );
    noise = (noise - 0.5) * 5.0;
    return 0.9 + noise * 0.2;
}

float flow(vec3 decomposed, float time) {
    return mix(
        texture(uPerlinTexture, vec2(time, decomposed.x / 2.0)).r,
        texture(uPerlinTexture, vec2(time, decomposed.y / 2.0)).r,
        decomposed.z
    );
}

void main() {
    vec2 uv = (vUv * 2.0 - 1.0) * 1.08;

    float radius = length(uv);
    float theta = atan(uv.y, uv.x);
    if (theta < 0.0) theta += 2.0 * PI;

    vec3 decomposed = vec3(
        theta / (2.0 * PI),
        mod(theta / (2.0 * PI) + 0.5, 1.0) + 1.0,
        abs(theta / PI - 1.0)
    );

    float noise = flow(decomposed, radius * 0.03 - uAnimation * 0.2) - 0.5;
    theta += noise * mix(0.08, 0.25, uOutputVolume);

    vec4 color = vec4(1.0, 1.0, 1.0, 1.0);

    float originalCenters[7] = float[7](0.0, 0.5 * PI, 1.0 * PI, 1.5 * PI, 2.0 * PI, 2.5 * PI, 3.0 * PI);

    float centers[7];
    for (int i = 0; i < 7; i++) {
        centers[i] = originalCenters[i] + 0.5 * sin(uTime / 20.0 + uOffsets[i]);
    }

    float a, b;
    vec4 ovalColor;

    for (int i = 0; i < 7; i++) {
        float n = texture(uPerlinTexture, vec2(mod(centers[i] + uTime * 0.05, 1.0), 0.5)).r;
        a = 0.5 + n * 0.3;
        b = n * mix(3.5, 2.5, uInputVolume);
        bool reverseGradient = (i - (i / 2) * 2 == 1);

        float distTheta = min(
            abs(theta - centers[i]),
            min(
                abs(theta + 2.0 * PI - centers[i]),
                abs(theta - 2.0 * PI - centers[i])
            )
        );

        if (drawOval(vec2(distTheta, radius), vec2(0.0, 0.0), a, b, reverseGradient, 0.6, ovalColor)) {
            color.rgb = mix(color.rgb, ovalColor.rgb, ovalColor.a);
            color.a = max(color.a, ovalColor.a);
        }
    }

    float ringRadius1 = sharpRing(decomposed, uTime * 0.1);
    float ringRadius2 = smoothRing(decomposed, uTime * 0.1);

    float inputRadius1 = radius + uInputVolume * 0.2;
    float inputRadius2 = radius + uInputVolume * 0.15;
    float opacity1 = mix(0.2, 0.6, uInputVolume);
    float opacity2 = mix(0.15, 0.45, uInputVolume);

    float ringAlpha1 = (inputRadius2 >= ringRadius1) ? opacity1 : 0.0;
    float ringAlpha2 = smoothstep(ringRadius2 - 0.05, ringRadius2 + 0.05, inputRadius1) * opacity2;

    float totalRingAlpha = max(ringAlpha1, ringAlpha2);

    color.rgb = 1.0 - (1.0 - color.rgb) * (1.0 - vec3(1.0) * totalRingAlpha);

    float luminance = mix(color.r, 1.0 - color.r, uInverted);
    color.rgb = colorRamp(luminance, vec3(0.0), uColor1, uColor2, vec3(1.0));

    color.a *= 1.0 - smoothstep(0.78, 1.0, radius);
    color.a *= uOpacity;

    fragColor = vec4(color.rgb * color.a, color.a);
}`;

  // shared between the render loop and the talk controller
  const orbConversation: { current: any } = { current: null };
  const orbMode: { current: null | string } = { current: null };

  function initOrb() {
    const canvas = document.getElementById('voice-orb') as HTMLCanvasElement | null;
    if (!canvas) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduced.matches) return;
    const gl = canvas.getContext('webgl2', {
      alpha: true,
      antialias: true,
      premultipliedAlpha: true,
    });
    if (!gl) return;

    function compile(type: number, src: string) {
      const s = gl!.createShader(type)!;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      return s;
    }
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(program);

    // Compile on background threads where supported; never block the
    // main thread waiting on the shader compiler.
    const parallel = gl.getExtension('KHR_parallel_shader_compile');
    const whenLinked = (cb: () => void) => {
      if (
        parallel &&
        !gl.getProgramParameter(program, parallel.COMPLETION_STATUS_KHR)
      ) {
        requestAnimationFrame(() => whenLinked(cb));
        return;
      }
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
      cb();
    };
    whenLinked(() => runOrb(canvas, gl, program, reduced));
  }

  function runOrb(
    canvas: HTMLCanvasElement,
    gl: WebGL2RenderingContext,
    program: WebGLProgram,
    reduced: MediaQueryList
  ) {
    gl.useProgram(program);

    const quad = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, quad);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW
    );
    const posLoc = gl.getAttribLocation(program, 'position');
    gl.enableVertexAttribArray(posLoc);
    gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);

    const U = (name: string) => gl.getUniformLocation(program, name);
    const uTime = U('uTime');
    const uAnimation = U('uAnimation');
    const uInverted = U('uInverted');
    const uInput = U('uInputVolume');
    const uOutput = U('uOutputVolume');
    const uOpacity = U('uOpacity');

    const uColor1 = U('uColor1');
    const uColor2 = U('uColor2');
    const offsets = new Float32Array(
      Array.from({ length: 7 }, () => Math.random() * Math.PI * 2)
    );
    gl.uniform1fv(U('uOffsets'), offsets);

    const setInverted = () => {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      gl.uniform1f(uInverted, dark ? 1 : 0);
      if (dark) {
        gl.uniform3f(uColor1, 0.227, 0.635, 0.769); /* #3aa2c4 teal-blue */
        gl.uniform3f(uColor2, 0.647, 0.894, 0.878); /* #a5e4e0 light teal */
      } else {
        /* saturated teal pair so the orb pops on the off-white canvas */
        gl.uniform3f(uColor1, 0.122, 0.561, 0.722); /* #1f8fb8 deep teal */
        gl.uniform3f(uColor2, 0.435, 0.816, 0.847); /* #6fd0d8 light teal */
      }
    };
    setInverted();
    new MutationObserver(setInverted).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // texture
    let textureReady = false;
    const tex = gl.createTexture();
    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([128, 128, 128, 255]));
    const img = new Image();
    img.onload = () => {
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      textureReady = true;
    };
    img.src = '/perlin-noise.png';
    gl.uniform1i(U('uPerlinTexture'), 0);

    // page energy stands in for voice volume
    let energy = 0;
    let stamp = 0;
    let lastY = window.pageYOffset;
    const bump = (amount: number) => {
      const now = performance.now();
      energy = Math.min(1, energy * Math.exp(-(now - stamp) / 900) + amount);
      stamp = now;
    };
    window.addEventListener(
      'scroll',
      () => {
        const y = window.pageYOffset;
        bump(Math.abs(y - lastY) / 320);
        lastY = y;
      },
      { passive: true }
    );
    window.addEventListener(
      'pointermove',
      (e) => {
        const r = canvas.getBoundingClientRect();
        if (!r.width) return;
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const d = Math.sqrt(dx * dx + dy * dy);
        const reach = Math.max(r.width, 360);
        if (d < reach) bump(0.06 * (1 - d / reach));
      },
      { passive: true }
    );
    const liveEnergy = () =>
      Math.min(1, energy * Math.exp(-(performance.now() - stamp) / 900));

    // state
    let raf: number | null = null;
    let onscreen = true;
    let time = 0;
    let anim = 0.1;
    let animSpeed = 0.1;
    let curIn = 0;
    let curOut = 0;
    let opacity = 0;
    let last = 0;

    function size() {
      const r = canvas.getBoundingClientRect();
      if (!r.width) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
      gl.viewport(0, 0, canvas.width, canvas.height);
    }
    window.addEventListener('resize', size);

    function frame(ts: number) {
      raf = requestAnimationFrame(frame);
      if (!textureReady) return;
      const delta = last ? Math.min(0.05, (ts - last) / 1000) : 0.016;
      last = ts;

      time += delta * 0.5;
      opacity = Math.min(1, opacity + delta * 2);
      const t = time * 2;
      let targetIn: number;
      let targetOut: number;
      const conv = orbConversation.current;
      if (conv) {
        // a live call drives the orb, shaped by who is talking:
        // listening = rings pulse with the caller, speaking = fast flow with Lia
        const vin = conv.getInputVolume ? conv.getInputVolume() : 0;
        const vout = conv.getOutputVolume ? conv.getOutputVolume() : 0;
        if (orbMode.current === 'speaking') {
          targetIn = 0.15;
          targetOut = Math.min(1, 0.55 + vout * 1.1 + 0.08 * Math.sin(t * 3.6));
        } else {
          targetIn = Math.min(1, 0.45 + vin * 1.4 + 0.1 * Math.sin(t * 3.2));
          targetOut = 0.42;
        }
      } else {
        const e = liveEnergy();
        targetIn = Math.min(1, 0.12 + 0.06 * Math.sin(t * 0.7) + e);
        targetOut = Math.min(
          1,
          Math.max(0.36 + 0.08 * Math.sin(t * 1.05 + 0.6), 0.32 + 0.45 * e)
        );
      }
      curIn += (targetIn - curIn) * 0.2;
      curOut += (targetOut - curOut) * 0.2;
      const targetSpeed = 0.1 + (1 - Math.pow(curOut - 1, 2)) * 0.9;
      animSpeed += (targetSpeed - animSpeed) * 0.12;
      anim += delta * animSpeed;

      gl.uniform1f(uTime, time);
      gl.uniform1f(uAnimation, anim);
      gl.uniform1f(uInput, curIn);
      gl.uniform1f(uOutput, curOut);
      gl.uniform1f(uOpacity, opacity);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    function start() {
      if (raf || reduced.matches || !onscreen || document.hidden) return;
      size();
      last = 0;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = null;
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        onscreen = entries[entries.length - 1].isIntersecting;
        if (onscreen) start();
        else stop();
      }).observe(canvas);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    const onReduced = () => {
      if (reduced.matches) {
        stop();
        gl.clearColor(0, 0, 0, 0);
        gl.clear(gl.COLOR_BUFFER_BIT);
      } else start();
    };
    if (reduced.addEventListener) reduced.addEventListener('change', onReduced);

    start();
  }

  const kickoff = () => {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => initOrb(), { timeout: 1500 });
    } else {
      setTimeout(initOrb, 300);
    }
  };
  const rmq = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (rmq.matches && rmq.addEventListener) {
    rmq.addEventListener('change', function once() {
      if (!rmq.matches) {
        rmq.removeEventListener('change', once);
        kickoff();
      }
    });
  } else {
    kickoff();
  }

  // ---- talk to the agent ----
  const AGENT_ID = 'agent_7401kxfmyja1fyaacyfb09th9r56';

  // Safari drops audio if the SDK loads inside the click (the network wait
  // eats the user-gesture window). Preload the module, and unlock audio
  // synchronously in the gesture.
  let sdkPromise: Promise<any> | null = null;
  const preloadSdk = () => (sdkPromise ??= import('@elevenlabs/client'));
  let unlockCtx: AudioContext | null = null;
  function unlockAudio() {
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (!AC) return;
      if (!unlockCtx) unlockCtx = new AC();
      if (unlockCtx.state === 'suspended') unlockCtx.resume();
      const src = unlockCtx.createBufferSource();
      src.buffer = unlockCtx.createBuffer(1, 1, 22050);
      src.connect(unlockCtx.destination);
      src.start(0);
    } catch (e) {}
  }
  const IS_SAFARI = /^((?!chrome|android|crios|fxios).)*safari/i.test(navigator.userAgent);

  (function talkControl() {
    const btn = document.getElementById('orb-talk');
    const note = document.getElementById('orb-note');
    const canvas = document.getElementById('voice-orb');
    const wrap = document.getElementById('orb-visual');
    if (!btn) return;

    function setOrbMode(m: null | string) {
      orbMode.current = m;
      if (!wrap) return;
      wrap.classList.toggle('is-connecting', m === 'connecting');
      wrap.classList.toggle('is-listening', m === 'listening');
      wrap.classList.toggle('is-speaking', m === 'speaking');
    }
    let state: 'idle' | 'connecting' | 'live' = 'idle';
    let gen = 0;
    let watchdog: number | null = null;

    function setLabel(text: string) {
      btn!.textContent = text;
    }
    function setState(next: typeof state, label?: string) {
      state = next;
      setOrbMode(next === 'idle' ? null : next === 'connecting' ? 'connecting' : orbMode.current === 'speaking' ? 'speaking' : 'listening');
      btn!.classList.toggle('is-live', next === 'live');
      btn!.setAttribute('aria-pressed', next === 'live' ? 'true' : 'false');
      if (note) note.hidden = next === 'idle';
      setLabel(
        label ??
          (next === 'idle'
            ? 'Talk to Lia'
            : next === 'connecting'
              ? 'Connecting...'
              : 'Live · tap to end')
      );
    }
    function clearWatchdog() {
      if (watchdog) {
        clearTimeout(watchdog);
        watchdog = null;
      }
    }
    function fail(label: string) {
      clearWatchdog();
      setState('idle', label);
      setTimeout(() => {
        if (state === 'idle') setLabel('Talk to Lia');
      }, 2600);
    }

    async function endConv(conv: any) {
      try {
        await conv.endSession();
      } catch (e) {}
    }

    function stop() {
      gen++;
      clearWatchdog();
      const conv = orbConversation.current;
      orbConversation.current = null;
      setState('idle');
      if (conv) endConv(conv);
    }

    async function start() {
      const myGen = ++gen;
      setState('connecting');
      clearWatchdog();
      watchdog = window.setTimeout(() => {
        if (gen === myGen && state === 'connecting') {
          gen++;
          fail("Couldn't connect. Try again");
        }
      }, 12000);
      try {
        const mod = await preloadSdk();
        const conversation = await mod.Conversation.startSession({
          agentId: AGENT_ID,
          connectionType: IS_SAFARI ? 'webrtc' : 'websocket',
          onStatusChange: (s: { status: string }) => {
            if (gen !== myGen) return;
            if (s.status === 'connected') {
              clearWatchdog();
              if (state === 'connecting') setState('live');
            } else if (s.status === 'disconnected') {
              orbConversation.current = null;
              clearWatchdog();
              setState('idle');
            }
          },
          onModeChange: (m: { mode: string }) => {
            if (gen === myGen && state === 'live') {
              setOrbMode(m.mode === 'speaking' ? 'speaking' : 'listening');
              setState('live', m.mode === 'speaking' ? 'Speaking · tap to end' : 'Listening · tap to end');
            }
          },
          onError: (e: unknown) => {
            console.warn('agent session error', e);
            if (gen === myGen) stop();
          },
        });
        if (gen !== myGen) {
          endConv(conversation);
          return;
        }
        orbConversation.current = conversation;
        clearWatchdog();
        if (state === 'connecting') setState('live');
      } catch (e) {
        console.warn('agent connect failed', e);
        if (gen !== myGen) return;
        fail('Mic needed. Try again');
      }
    }

    function toggle() {
      unlockAudio();
      if (state === 'idle') start();
      else if (state === 'live') stop();
      // clicks during 'connecting' are ignored; the watchdog handles hangs
    }

    btn.addEventListener('click', toggle);
    btn.addEventListener('pointerenter', preloadSdk, { once: true });
    btn.addEventListener('touchstart', preloadSdk, { once: true, passive: true });
    if ('requestIdleCallback' in window) requestIdleCallback(() => preloadSdk());
    else setTimeout(preloadSdk, 2500);
    if (canvas) canvas.addEventListener('click', toggle);
    window.addEventListener('pagehide', () => {
      if (orbConversation.current) stop();
    });
  })();
</script>
