---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="nav">
  <div class="container-wide nav-inner">
    <a href="#top" class="nav-name">{site.name}</a>
    <div class="nav-links">
      <a href="#method" data-navlink>How I work</a>
      <a href="#work" data-navlink>Work</a>
      <a href="#range" data-navlink>Range</a>
      <a href="#experience" data-navlink>Experience</a>
      <a href={site.contact.github} target="_blank" rel="noopener">GitHub</a>
      <a class="nav-cta" href={`mailto:${site.contact.email}`}>Email me</a>
      <ThemeToggle />
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
  }
  .nav-name {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-links a {
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.2s var(--ease);
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .nav-links a[data-navlink].active {
    color: var(--text);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent) !important;
    font-weight: 500;
    transition: background-color 0.2s var(--ease);
  }
  .nav-cta:hover {
    background: var(--accent-hover);
  }
  @media (max-width: 700px) {
    .nav-links {
      gap: 12px;
    }
    .nav-links a {
      font-size: 13px;
    }
    .nav-links a[href="#method"],
    .nav-links a[href="#range"],
    .nav-links a[href="#experience"] {
      display: none;
    }
    .nav-cta {
      height: 30px;
      padding: 0 12px;
    }
  }
  @media (max-width: 430px) {
    .nav-name {
      font-size: 14px;
    }
    .nav-links a[href^="https://github"] {
      display: none;
    }
  }
</style>
