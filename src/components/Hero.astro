---
import { site } from '../data/site';
import { parseMarks } from '../lib/markup';
import VoiceOrb from './VoiceOrb.astro';
---

<header id="top" class="hero">
  <div class="container-wide hero-grid">
    <div class="hero-copy">
      <span class="badge reveal">{site.hero.badge}</span>
      <h1 class="display reveal" style="transition-delay: 80ms">{site.hero.headline}</h1>
      <p class="hero-sub reveal" style="transition-delay: 160ms">{parseMarks(site.hero.sub).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
      <div class="hero-ctas reveal" style="transition-delay: 240ms">
        {
          site.hero.ctas.map((c) =>
            c.primary ? (
              <a class="btn" href={c.href}>{c.label}</a>
            ) : (
              <a
                class="btn-ghost"
                href={c.href}
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel={c.href.startsWith('http') ? 'noopener' : undefined}
              >
                {c.label}
              </a>
            )
          )
        }
      </div>
      <div class="hero-metrics">
        {
          site.hero.metrics.map((m, i) => (
            <div class="chip reveal" style={`transition-delay: ${300 + i * 80}ms`}>
              <span class="chip-value" data-countup>{m.value}</span>
              <span class="chip-label">{m.label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-visual-inner reveal" style="transition-delay: 200ms">
        <VoiceOrb />
      </div>
      <button class="orb-talk" id="orb-talk" type="button" aria-label="Talk to Lia, Auskin's voice agent">
        Talk to Lia
      </button>
      <p class="orb-note" id="orb-note" hidden>
        Lia is a voice AI agent Auskin built. Conversations may be recorded.
      </p>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 140px 0 96px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 48px;
  }
  .display {
    margin-top: 26px;
    max-width: 14ch;
  }
  .hero-sub {
    margin-top: 26px;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--text-muted);
    max-width: 54ch;
  }
  .hero-ctas {
    margin-top: 36px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-metrics {
    margin-top: 48px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition: border-color 0.25s var(--ease);
  }
  .chip:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }
  .chip-value {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .chip-label {
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  /* The talk button lives OUTSIDE any transformed/faded/reveal element so
     its mobile fixed positioning never gets trapped in a stacking context. */
  .hero-visual {
    position: relative;
  }
  .orb-talk {
    position: absolute;
    left: 50%;
    bottom: 4px;
    transform: translateX(-50%);
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .orb-talk:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    transform: translateX(-50%) translateY(-1px);
  }
  .orb-talk.is-live {
    border-color: var(--green);
  }
  .orb-talk.is-live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  .orb-note {
    position: absolute;
    left: 50%;
    bottom: -26px;
    transform: translateX(-50%);
    z-index: 5;
    width: max-content;
    max-width: 90%;
    font-size: 11px;
    color: var(--text-muted);
    text-align: center;
  }
  @media (max-width: 900px) {
    .hero {
      padding: 104px 0 64px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero-visual {
      position: static;
    }
    .hero-visual-inner {
      position: absolute;
      top: 12px;
      right: -100px;
      width: 320px;
      opacity: 0.4;
      z-index: -1;
    }
    .orb-talk {
      position: fixed;
      left: auto;
      right: 18px;
      bottom: 18px;
      transform: none;
      z-index: 90;
      height: 42px;
      padding: 0 20px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.14);
    }
    .orb-talk:hover {
      transform: none;
    }
    .orb-note {
      position: fixed;
      left: auto;
      right: 18px;
      bottom: 64px;
      transform: none;
      z-index: 90;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      padding: 4px 10px;
      border-radius: 8px;
    }
  }
</style>
