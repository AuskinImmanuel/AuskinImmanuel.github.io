---
import { site } from '../data/site';
---

<header id="top" class="hero">
  <div class="container">
    <h1 class="hero-headline reveal">{site.hero.headline}</h1>
    <p class="hero-sub reveal" style="transition-delay: 90ms">{site.hero.sub}</p>
    <div class="hero-metrics">
      {
        site.hero.metrics.map((m, i) => (
          <div class="metric reveal" style={`transition-delay: ${160 + i * 90}ms`}>
            <span class="metric-value">{m.value}</span>
            <span class="metric-label">{m.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</header>

<style>
  .hero {
    padding: 150px 0 110px;
  }
  .hero-headline {
    font-size: clamp(2.7rem, 7vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 15ch;
  }
  .hero-sub {
    margin-top: 22px;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    color: var(--text-muted);
    font-weight: 400;
  }
  .hero-metrics {
    margin-top: 60px;
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .metric-value {
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .metric-label {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  @media (max-width: 700px) {
    .hero {
      padding: 96px 0 64px;
    }
    .hero-metrics {
      gap: 32px;
      margin-top: 44px;
    }
  }
</style>
