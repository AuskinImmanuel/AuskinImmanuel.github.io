---
import { site } from '../data/site';
import { parseMarks } from '../lib/markup';
---

<section id="method" class="method band">
  <div class="container">
    <h2 class="section-label reveal">How I work</h2>
    <div class="method-lead">
      <p class="method-statement reveal">{parseMarks(site.method.statement).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
      <figure class="portrait reveal">
        <img src="/auskin-portrait.jpg" alt="Auskin Immanuel" width="1080" height="1350" loading="lazy" />
      </figure>
    </div>
  </div>
  <div class="container-wide">
    <div class="method-steps">
      <div class="method-rail" aria-hidden="true"><span class="method-rail-line draw-line-x"></span></div>
      {
        site.method.steps.map((s, i) => (
          <article class="method-step reveal" style={`transition-delay: ${i * 80}ms`}>
            <span class="method-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="method-title">{s.title}</h3>
            <p class="method-blurb">{parseMarks(s.blurb).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
            <p class="method-proof">{parseMarks(s.proof).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
          </article>
        ))
      }
    </div>
    <div class="habits">
      <h3 class="habits-label reveal">{site.habits.label}</h3>
      <p class="habits-intro reveal">{site.habits.intro}</p>
      <div class="habits-grid">
        {
          site.habits.items.map((h, i) => (
            <div class="habit reveal" style={`transition-delay: ${i * 80}ms`}>
              <h4 class="habit-title">{h.title}</h4>
              <p class="habit-blurb">
                {parseMarks(h.blurb).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .method-statement {
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    max-width: 760px;
  }
  .method-lead {
    display: flex;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }
  .method-lead .method-statement {
    flex: 1;
  }
  .portrait {
    margin: 0;
    flex: 0 0 auto;
  }
  .portrait img {
    display: block;
    width: clamp(180px, 22vw, 260px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 18px;
    border: 1px solid var(--border);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.08),
      0 24px 64px -24px color-mix(in oklab, var(--accent) 45%, transparent);
  }
  @media (max-width: 720px) {
    .method-lead {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
    .portrait img {
      width: 180px;
    }
  }
  .method-steps {
    position: relative;
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .method-rail {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    height: 1px;
    overflow: hidden;
  }
  .method-rail-line {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--border);
  }
  .method-step {
    padding-top: 34px;
    position: relative;
  }
  .method-step::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .method-num {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .method-title {
    margin-top: 8px;
    font-size: 1.25rem;
  }
  .method-blurb {
    margin-top: 12px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .method-proof {
    margin-top: 14px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    border-left: 2px solid var(--accent);
    padding-left: 10px;
  }
  .habits {
    margin-top: 88px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .habits-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .habits-intro {
    margin-top: 14px;
    font-size: 1.05rem;
    max-width: 56ch;
  }
  .habits-grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .habit-title {
    font-size: 1.05rem;
  }
  .habit-blurb {
    margin-top: 10px;
    font-size: 0.93rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .habits-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .method-steps {
      grid-template-columns: 1fr 1fr;
      row-gap: 44px;
    }
    .method-rail {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .method-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
