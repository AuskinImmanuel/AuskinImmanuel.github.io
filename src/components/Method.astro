---
import { site } from '../data/site';
import { parseMarks } from '../lib/markup';
---

<section id="method" class="method band">
  <div class="container">
    <h2 class="section-label reveal">How I work</h2>
    <div class="method-lead">
      <p class="method-statement reveal">{parseMarks(site.method.statement).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
      <figure class="portrait-scene reveal">
        <img class="portrait-ambient" src="/auskin-portrait.png" alt="" aria-hidden="true" width="1024" height="1024" loading="lazy" />
        <img class="portrait-cut" src="/auskin-portrait.png" alt="Auskin Immanuel" width="1024" height="1024" loading="lazy" />
        <span class="portrait-grain" aria-hidden="true"></span>
      </figure>
    </div>
  </div>
  <div class="container-wide">
    <div class="method-steps">
      <div class="method-rail" aria-hidden="true"><span class="method-rail-line draw-line-x"></span></div>
      {
        site.method.steps.map((s, i) => (
          <article class="method-step reveal" style={`transition-delay: ${i * 80}ms`}>
            <span class="method-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="method-title">{s.title}</h3>
            <p class="method-blurb">{parseMarks(s.blurb).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
            <p class="method-proof">{parseMarks(s.proof).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}</p>
          </article>
        ))
      }
    </div>
    <div class="habits">
      <h3 class="habits-label reveal">{site.habits.label}</h3>
      <p class="habits-intro reveal">{site.habits.intro}</p>
      <div class="habits-grid">
        {
          site.habits.items.map((h, i) => (
            <div class="habit reveal" style={`transition-delay: ${i * 80}ms`}>
              <h4 class="habit-title">{h.title}</h4>
              <p class="habit-blurb">
                {parseMarks(h.blurb).map((m) => (m.t === 'text' ? m.v : m.t === 'hl' ? <em class="hl">{m.v}</em> : <em class="em-acc">{m.v}</em>))}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .method-statement {
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.01em;
    max-width: 760px;
  }
  /* .method-lead and .portrait-scene styles live in global.css so they
     survive any scoping surprises in the build. */

  .method-steps {
    position: relative;
    margin-top: 72px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .method-rail {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    height: 1px;
    overflow: hidden;
  }
  .method-rail-line {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--border);
  }
  .method-step {
    padding-top: 34px;
    position: relative;
  }
  .method-step::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .method-num {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .method-title {
    margin-top: 8px;
    font-size: 1.25rem;
  }
  .method-blurb {
    margin-top: 12px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .method-proof {
    margin-top: 14px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    border-left: 2px solid var(--accent);
    padding-left: 10px;
  }
  .habits {
    margin-top: 88px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .habits-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .habits-intro {
    margin-top: 14px;
    font-size: 1.05rem;
    max-width: 56ch;
  }
  .habits-grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .habit-title {
    font-size: 1.05rem;
  }
  .habit-blurb {
    margin-top: 10px;
    font-size: 0.93rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .habits-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .method-steps {
      grid-template-columns: 1fr 1fr;
      row-gap: 44px;
    }
    .method-rail {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .method-steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Two-depth pointer parallax + proximity glow warm-up for the portrait.
  // Desktop pointer devices only; sleeps when settled; transform/opacity only.
  const scene = document.querySelector<HTMLElement>('.portrait-scene');
  const section = document.getElementById('method');
  if (
    scene &&
    section &&
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    let tx = 0, ty = 0, tn = 0;
    let cx = 0, cy = 0, cn = 0;
    let raf = 0;
    const tick = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      cn += (tn - cn) * 0.08;
      scene.style.setProperty('--px', cx.toFixed(4));
      scene.style.setProperty('--py', cy.toFixed(4));
      scene.style.setProperty('--near', cn.toFixed(4));
      if (Math.abs(tx - cx) + Math.abs(ty - cy) + Math.abs(tn - cn) > 0.002) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
      }
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    section.addEventListener('pointermove', (e) => {
      const r = section.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width) * 2 - 1;
      ty = ((e.clientY - r.top) / r.height) * 2 - 1;
      const s = scene.getBoundingClientRect();
      const dx = e.clientX - (s.left + s.width / 2);
      const dy = e.clientY - (s.top + s.height / 2);
      tn = Math.max(0, 1 - Math.hypot(dx, dy) / (r.width * 0.5));
      wake();
    });
    section.addEventListener('pointerleave', () => {
      tx = 0; ty = 0; tn = 0;
      wake();
    });
  }
</script>
